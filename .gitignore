yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm
.yarn-integrity

# Ruby
*.gem
.bundle
vendor/bundle

#================================================
# CI/CD & PIPELINE FILES
#================================================

# Pipeline artifacts
artifacts/
.artifacts/

# Test outputs
*.junit.xml
test-output/

# Build outputs
dist/
build/
out/

#================================================
# TERRAFORM SPECIFIC PATTERNS
#================================================

# Lock files from modules
**/.terraform.lock.hcl.backup

# Generated documentation
terraform-docs/
docs/generated/

# Sentinel (Terraform Enterprise)
.sentinel/

# Terragrunt
.terragrunt-cache/

