#================================================
# TERRAFORM FILES
#================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files - contain infrastructure state and sensitive data
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*tfplan*
plan.out
tfplan

# Exclude all .tfvars files - likely to contain sensitive data
# (passwords, private keys, secrets, etc.)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Ignore override files (used for local development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform cache and plugin directories
.terraform.lock.hcl
.terraform.lock.hcl.*
terraform.tfstate.d/

#================================================
# SENSITIVE DATA & SECRETS
#================================================

# SSH keys
*.pem
*.key
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# SSL/TLS certificates
*.crt
*.cer
*.pfx
*.p12

# Environment files with secrets
.env
.env.*
!.env.example
!.env.template
*.secret
secrets.yml
secrets.yaml
secrets.json

# Password and credential files
passwords.txt
credentials.txt
credentials.json

# Azure service principal files
azure-credentials.json
sp-credentials.json
service-principal.json

# Kubeconfig files (may contain credentials)
kubeconfig
*.kubeconfig
config.kubernetes

#================================================
# LOGS & REPORTS
#================================================

# General logs
*.log
logs/
*.log.*

# Azure logs
azure-debug.log

# Test and coverage reports
coverage/
test-results/
*.coverage
.coverage
htmlcov/

# Cost analysis and reports
cost-analysis-*.json
cost-analysis-*.txt
cost-optimization-recommendations.md
*_costs_raw.*
backup-report-*.txt
health-check-*.txt
security-summary-*.txt

# Terraform output files
terraform-output.json
outputs.json

