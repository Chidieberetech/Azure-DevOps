.azure/

# Azure Functions
local.settings.json
.python_packages/
__blobstorage__/
__queuestorage__/
__azurite_db*__.json

#================================================
# SCRIPTING & DEPENDENCIES
#================================================

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# Node.js
node_modules/
